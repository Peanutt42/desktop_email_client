  "query": "\n\t\t\tSELECT\n\t\t\t\t*,\n\t\t\t\t-- Ensure we get '[]' instead of '[null]' when no tags exist\n\t\t\t\tCOALESCE(\n\t\t\t\t\t(SELECT json_group_array(f.name)\n\t\t\t\t\tFROM email_tags_refs etr\n\t\t\t\t\tJOIN email_folders f ON etr.folder_id = f.id\n\t\t\t\t\tWHERE etr.email_id = id),\n\t\t\t\t\t'[]'\n\t\t\t\t) as \"tags!\"\n\t\t\tFROM emails\n\t\t\tWHERE id = ?\n\t\t\t",
