{
  "name": "desktop_email_client",
  "version": "0.1.0",
  "description": "Desktop email client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "40.6.1",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.github.p3anutt42.desktop_email_client",
    "productName": "Desktop Email Client",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/release/desktop_email_client_backend",
        "to": "backend/desktop_email_client_backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "../target/release/desktop_email_client_backend.exe",
          "to": "backend/desktop_email_client_backend"
        }
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
